rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isServiceAdmin() {
      return signedIn() && request.auth.token.email in [
        "muxdtuber@gmail.com"
      ];
    }

    // O doc do usuário guarda o plano da assinatura. Faltava regra aqui: sem
    // ela o Firestore negava a leitura por padrão, o useIsPremium caía no erro
    // e tratava todo mundo como gratuito — premium nunca ligaria, mesmo com o
    // pagamento confirmado.
    //
    // `plan` é escrito SÓ pelo webhook, via Admin SDK, que ignora estas regras.
    // Nenhum caminho do cliente pode escrever aqui: senão bastava abrir o
    // console do navegador pra virar premium de graça.
    match /users/{userId} {
      allow read: if isOwner(userId) || isServiceAdmin();
      allow write: if false;
    }

    match /users/{userId}/cars/{carId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/private/{docId} {
      allow read, write: if isOwner(userId);
    }

    // Conquistas: um documento por marco, com o id sendo o próprio marco.
    //
    // Quem detecta o cruzamento é o cliente de quem praticou a ação — o Firebase
    // está no plano Spark, então não há Cloud Function pra fazer isso do lado do
    // servidor. Ou seja: é escrita no perfil de OUTRA pessoa, e a regra é a
    // única defesa. Ela faz três coisas:
    //
    //   1. `create` apenas, nunca `update` — conquista não muda, ela acontece.
    //      Como o Firestore nega `create` em documento existente, dois cliques
    //      simultâneos cruzando o mesmo marco não duplicam: o segundo falha
    //      sozinho, sem transação e sem notificação repetida.
    //   2. lista FECHADA de ids. Sem isso, campo livre viraria selo inventado.
    //   3. `unlockedAt` é a única coisa no corpo, então não dá pra pendurar
    //      dado arbitrário no perfil alheio usando a conquista como carona.
    //
    // Apagar é do dono: conquista precisa ser revogável sem reconstruir nada,
    // porque ela não guarda estado incremental — só "aconteceu". É a rede de
    // segurança contra fraude descoberta depois, e sai de graça neste desenho.
    match /users/{userId}/achievements/{achievementId} {
      function marcoValido() {
        return achievementId in [
          "first_goal",
          "first_conquest",
          "owned_car",
          "followers_1000",
          "likes_1000",
          "likes_10000",
          "likes_50000",
          "likes_100000",
          "likes_500000",
          "likes_1000000"
        ];
      }

      // Conquista é vitrine: aparece no perfil público de quem visita.
      allow read: if true;

      allow create: if signedIn()
        && marcoValido()
        && request.resource.data.keys().hasOnly(["unlockedAt"]);

      allow update: if false;
      allow delete: if isOwner(userId) || isServiceAdmin();
    }

    match /users/{userId}/notifications/{notificationId} {
      // Aviso e escrita alheia por natureza: quem notifica e quem agiu, do
      // cliente dele, porque o plano Spark nao tem Cloud Function pra fazer
      // isso do lado do servidor. `signedIn()` sozinho deixava qualquer conta
      // escrever qualquer coisa na caixa de qualquer pessoa: texto livre,
      // remetente forjado, ja marcado como lido, com data no futuro pra ficar
      // grudado no topo. Todos os sete pontos que notificam no app passam pelo
      // mesmo `notifyUser`, entao a regra pode exigir o formato que ele produz.
      function notificacaoHonesta() {
        return request.resource.data.type in [
                 "follow", "like", "comment", "rating", "achievement",
                 "message",
                 "service_approved", "service_changes_requested", "service_rejected"
               ]
               // Nao da pra assinar em nome de outro.
               && request.resource.data.actorId == request.auth.uid
               // Nem entregar num endereco e dizer que era de outro.
               && request.resource.data.recipientId == userId
               // Nasce por ler; ninguem chega lido nem some da contagem.
               && request.resource.data.read == false
               // Sem data escolhida a dedo: futuro fixaria o aviso no topo.
               && request.resource.data.createdAt == request.time
               && (!("text" in request.resource.data)
                   || request.resource.data.text.size() < 500);
      }

      allow read, update, delete: if isOwner(userId);
      allow create: if signedIn() && notificacaoHonesta();
    }

    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /publicProfiles/{userId} {
      // Perfil público é vitrine: quem chega por link compartilhado precisa
      // ver de quem é a garagem antes de decidir criar conta.
      allow read: if true;
      allow create, update: if isOwner(userId) && request.resource.data.userId == request.auth.uid;
      allow delete: if isOwner(userId);

      // Seguidores: cada pessoa só cria/remove o próprio doc de seguidor.
      // `update` entra junto porque setDoc num doc que já existe (re-seguir
      // sem ter deixado de seguir) é update, não create.
      match /followers/{followerId} {
        allow read: if signedIn();
        allow create, update, delete: if signedIn() && request.auth.uid == followerId;
      }

      // Seguindo: espelho do doc de seguidor, guardado na conta de quem segue.
      // Qualquer pessoa logada lê (a aba "Seguindo" é pública), mas só o dono
      // da lista escreve nela.
      match /following/{targetUserId} {
        allow read: if signedIn();
        allow create, update, delete: if isOwner(userId);
      }
    }

    match /communityGoals/{goalId} {
      function isGoalOwner() {
        return signedIn() && resource.data.ownerId == request.auth.uid;
      }

      // Curtir, avaliar e comentar são updates no documento de OUTRA pessoa,
      // então update não pode ser negado pra quem não é dono — mas também não
      // pode ser liberado inteiro, senão qualquer um logado reescreve titulo,
      // foto, valores ou legenda de qualquer publicação. Visitante só encosta
      // nestes campos, e em likesBy/ratingsBy só na própria chave.
      // O `.get(campo, {})` cobre documento antigo que nem tem o mapa.
      //
      // `likesCount` é número de VITRINE, mantido por quem curte. Como é escrita
      // no documento alheio, a regra prende o passo em 1 pra cima ou 1 pra baixo
      // — sem isso um cliente manda increment(9999) numa curtida só. Quem manda
      // na verdade é a subcoleção `likes` abaixo, que ninguém consegue forjar;
      // por isso o marco de conquista se conta lá, não neste número.
      //
      // `likesBy` continua na lista só durante a transição: o mapa está sendo
      // esvaziado e o código novo não escreve nele. Sai numa limpeza depois de a
      // migração estar confirmada — tirar agora quebraria qualquer build antigo
      // que ainda esteja no ar.
      function onlyInteraction() {
        let antes = resource.data.get("likesCount", 0);
        let depois = request.resource.data.get("likesCount", 0);
        return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["likesBy", "likesCount", "ratingsBy", "comments", "updatedAt"])
          && depois >= antes - 1
          && depois <= antes + 1
          && request.resource.data.get("likesBy", {})
            .diff(resource.data.get("likesBy", {}))
            .affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.get("ratingsBy", {})
            .diff(resource.data.get("ratingsBy", {}))
            .affectedKeys().hasOnly([request.auth.uid]);
      }

      // Meta publicada na comunidade é conteúdo público: quem abre o link
      // compartilhado vê o feed antes de criar conta. Interagir (curtir,
      // comentar, avaliar) continua exigindo login.
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isGoalOwner() || (signedIn() && onlyInteraction());
      allow delete: if isGoalOwner();

      // Quem curtiu: um documento por pessoa, com o uid como id.
      //
      // Antes a curtida era uma chave no mapa `likesBy`, DENTRO do documento do
      // post. Documento no Firestore tem teto de 1 MiB, e comentários dividem o
      // mesmo espaço — medido em 22/08/2026, o post travava em ~16.900 curtidas,
      // e em ~2.800 num post com 2.000 comentários. Ou seja: quanto mais viral,
      // menor o teto. Os marcos de 50k pra cima que o produto quer eram
      // impossíveis, não difíceis.
      //
      // Mesma forma que os participantes de evento: o id ser o uid dá dedup de
      // graça e torna a escrita de terceiro inexistente em vez de limitada.
      match /likes/{likerId} {
        // Post é público; quem curtiu também.
        allow read: if true;

        // `postOwnerId` é conferido contra o dono real do post porque é o campo
        // que soma o total do perfil — sem isso dava pra inflar o número de
        // outra pessoa gravando o uid dela numa curtida qualquer.
        allow create: if signedIn()
          && request.auth.uid == likerId
          && request.resource.data.likerId == likerId
          && request.resource.data.postOwnerId ==
             get(/databases/$(database)/documents/communityGoals/$(goalId)).data.ownerId;

        // Curtida não tem estado pra mudar: ou existe, ou não existe.
        allow update: if false;

        allow delete: if signedIn() && request.auth.uid == likerId;
      }
    }

    // A colecao `events` nao tinha regra nenhuma e caia no deny padrao. Medido
    // em 21/08/2026: 10/10 carregamentos devolviam "Missing or insufficient
    // permissions" e a tela mostrava "Nenhum evento encontrado" — que e mentira,
    // nao e ausencia, e proibicao. A feature de Eventos nunca funcionou em
    // producao para ninguem, nem para quem estava logado.
    match /events/{eventId} {
      // O Engine abre sem login e a agenda e parte do convite: evento e publico.
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid;

      // So o dono edita o evento. Confirmar presenca NAO passa mais por aqui:
      // virou documento proprio na subcolecao abaixo. Antes o RSVP era escrita
      // no documento de outra pessoa, e como o cancelamento reescrevia o array
      // inteiro nenhuma regra conseguia provar QUEM tinha saido — dava pra
      // apagar a presenca alheia. Agora essa escrita simplesmente nao existe.
      allow update: if signedIn()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid;

      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;

      // Quem vai ao evento: um documento por pessoa, com o uid como id. A regra
      // fica trivial e forte — voce so escreve no doc que tem o SEU uid.
      //
      // O contador tambem saiu do documento do evento: era desnormalizado,
      // precisava ser escrito por quem confirma (de novo, escrita alheia) e
      // podia sair de sincronia. Agora o numero vem de getCountFromServer.
      //
      // LIMITE CONHECIDO: apagar o evento nao apaga a subcolecao — o Firestore
      // nao faz cascata. Os docs de participante ficam orfaos, invisiveis e
      // inofensivos, mas ficam. Limpar de verdade quer Cloud Function.
      match /participants/{participantId} {
        // A lista de quem vai e publica, como o evento.
        allow read: if true;

        allow create, update: if signedIn()
          && request.auth.uid == participantId
          && request.resource.data.uid == participantId;

        allow delete: if signedIn() && request.auth.uid == participantId;
      }
    }

    // Consulta de GRUPO (collectionGroup) NÃO passa pela regra aninhada dentro de
    // communityGoals: o Firestore avalia um caminho recursivo, não o caminho
    // concreto do documento. Sem este bloco a leitura direta da subcoleção
    // funciona e a consulta de grupo é negada — foi exatamente o que aconteceu
    // em 22/08/2026, e os 35 testes não pegaram porque nenhum fazia consulta de
    // grupo.
    //
    // O feed usa essa consulta uma vez por sessão para saber quais posts a
    // pessoa já curtiu; sem ela, voltaria a perguntar post a post.
    //
    // Só LEITURA. Escrita continua presa ao caminho concreto acima, onde o id
    // do documento tem que ser o uid de quem escreve.
    match /{caminho=**}/likes/{likerId} {
      allow read: if true;
    }

    // Denúncias: qualquer pessoa logada abre uma, ninguém além da moderação lê
    // ou mexe depois — inclusive quem denunciou não relê a própria denúncia.
    match /reports/{reportId} {
      allow read, update, delete: if isServiceAdmin();
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetId is string
        && request.resource.data.reason is string;
    }

    // Mensagens diretas: só quem está na conversa lê ou escreve.
    match /conversations/{conversationId} {
      function isMember() {
        return signedIn() && request.auth.uid in resource.data.memberIds;
      }

      function memberIdsOf(id) {
        return get(/databases/$(database)/documents/conversations/$(id)).data.memberIds;
      }

      // `get` num doc inexistente traz resource == null: sem esse caso, ler
      // uma conversa que ainda vai ser criada é negado e ninguém consegue
      // abrir o primeiro papo. Em list, todo doc devolvido existe.
      allow get: if resource == null || isMember();
      allow list: if isMember();
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() == 2;
      // A lista de participantes é imutável — ninguém entra numa conversa alheia.
      allow update: if isMember()
        && request.resource.data.memberIds == resource.data.memberIds;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in memberIdsOf(conversationId);
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in memberIdsOf(conversationId);
        allow update, delete: if signedIn()
          && resource.data.senderId == request.auth.uid;
      }
    }

    match /serviceListings/{listingId} {
      // Anúncio aprovado é público de propósito: o prestador divulga o link do
      // Engine na bio dele, e quem chega por ali ainda não tem conta. Exigir
      // login aqui entregava tela vazia justamente pra quem ele trouxe.
      // Rascunho e reprovado continuam restritos ao dono e à moderação.
      allow read: if resource.data.moderationStatus == "approved"
        || (signedIn() && resource.data.ownerId == request.auth.uid)
        || isServiceAdmin();

      // Métricas do anúncio: quem visita incrementa o contador no documento de
      // outra pessoa, então update não pode ser só do dono. A trava é dupla —
      // só estes três campos, e cada um só pode ficar igual ou subir de um em
      // um, nunca cair nem pular. Não dá pra zerar a métrica alheia nem
      // mascarar edição de conteúdo como se fosse visita.
      function onlyMetricIncrement() {
        let counters = ["viewCount", "detailCount", "whatsappCount"];
        let before = resource.data;
        let after = request.resource.data;
        return after.diff(before).affectedKeys().hasOnly(counters)
          && after.get("viewCount", 0) >= before.get("viewCount", 0)
          && after.get("viewCount", 0) <= before.get("viewCount", 0) + 1
          && after.get("detailCount", 0) >= before.get("detailCount", 0)
          && after.get("detailCount", 0) <= before.get("detailCount", 0) + 1
          && after.get("whatsappCount", 0) >= before.get("whatsappCount", 0)
          && after.get("whatsappCount", 0) <= before.get("whatsappCount", 0) + 1;
      }
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.moderationStatus == "pending";
      allow update: if isServiceAdmin()
        || onlyMetricIncrement()
        || (
          signedIn()
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.moderationStatus == "pending"
        );
      allow delete: if isServiceAdmin()
        || (signedIn() && resource.data.ownerId == request.auth.uid);
    }
  }
}
