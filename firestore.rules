rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isServiceAdmin() {
      return signedIn() && request.auth.token.email in [
        "muxdtuber@gmail.com"
      ];
    }

    match /users/{userId}/cars/{carId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/private/{docId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/notifications/{notificationId} {
      allow read, update, delete: if isOwner(userId);
      allow create: if signedIn();
    }

    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /publicProfiles/{userId} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId) && request.resource.data.userId == request.auth.uid;
      allow delete: if isOwner(userId);

      // Seguidores: cada pessoa só cria/remove o próprio doc de seguidor.
      // `update` entra junto porque setDoc num doc que já existe (re-seguir
      // sem ter deixado de seguir) é update, não create.
      match /followers/{followerId} {
        allow read: if signedIn();
        allow create, update, delete: if signedIn() && request.auth.uid == followerId;
      }

      // Seguindo: espelho do doc de seguidor, guardado na conta de quem segue.
      // Qualquer pessoa logada lê (a aba "Seguindo" é pública), mas só o dono
      // da lista escreve nela.
      match /following/{targetUserId} {
        allow read: if signedIn();
        allow create, update, delete: if isOwner(userId);
      }
    }

    match /communityGoals/{goalId} {
      function isGoalOwner() {
        return signedIn() && resource.data.ownerId == request.auth.uid;
      }

      // Curtir, avaliar e comentar são updates no documento de OUTRA pessoa,
      // então update não pode ser negado pra quem não é dono — mas também não
      // pode ser liberado inteiro, senão qualquer um logado reescreve titulo,
      // foto, valores ou legenda de qualquer publicação. Visitante só encosta
      // nestes campos, e em likesBy/ratingsBy só na própria chave.
      // O `.get(campo, {})` cobre documento antigo que nem tem o mapa.
      function onlyInteraction() {
        return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["likesBy", "ratingsBy", "comments", "updatedAt"])
          && request.resource.data.get("likesBy", {})
            .diff(resource.data.get("likesBy", {}))
            .affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.get("ratingsBy", {})
            .diff(resource.data.get("ratingsBy", {}))
            .affectedKeys().hasOnly([request.auth.uid]);
      }

      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isGoalOwner() || (signedIn() && onlyInteraction());
      allow delete: if isGoalOwner();
    }

    // Denúncias: qualquer pessoa logada abre uma, ninguém além da moderação lê
    // ou mexe depois — inclusive quem denunciou não relê a própria denúncia.
    match /reports/{reportId} {
      allow read, update, delete: if isServiceAdmin();
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetId is string
        && request.resource.data.reason is string;
    }

    // Mensagens diretas: só quem está na conversa lê ou escreve.
    match /conversations/{conversationId} {
      function isMember() {
        return signedIn() && request.auth.uid in resource.data.memberIds;
      }

      function memberIdsOf(id) {
        return get(/databases/$(database)/documents/conversations/$(id)).data.memberIds;
      }

      // `get` num doc inexistente traz resource == null: sem esse caso, ler
      // uma conversa que ainda vai ser criada é negado e ninguém consegue
      // abrir o primeiro papo. Em list, todo doc devolvido existe.
      allow get: if resource == null || isMember();
      allow list: if isMember();
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() == 2;
      // A lista de participantes é imutável — ninguém entra numa conversa alheia.
      allow update: if isMember()
        && request.resource.data.memberIds == resource.data.memberIds;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in memberIdsOf(conversationId);
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in memberIdsOf(conversationId);
        allow update, delete: if signedIn()
          && resource.data.senderId == request.auth.uid;
      }
    }

    match /serviceListings/{listingId} {
      allow read: if signedIn()
        && (
          resource.data.moderationStatus == "approved"
          || resource.data.ownerId == request.auth.uid
          || isServiceAdmin()
        );
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.moderationStatus == "pending";
      allow update: if isServiceAdmin()
        || (
          signedIn()
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.moderationStatus == "pending"
        );
      allow delete: if isServiceAdmin()
        || (signedIn() && resource.data.ownerId == request.auth.uid);
    }
  }
}
