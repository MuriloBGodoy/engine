VITE_API_URL=http://localhost:8080/api

# Google AdSense (anúncios). Enquanto estas variáveis ficarem vazias, o
# <AdSlot /> mostra um "house ad" (convite ao Premium) em vez de anúncio real.
# Preencha depois que a conta do AdSense for aprovada.
#   VITE_ADSENSE_CLIENT: seu publisher id, no formato ca-pub-0000000000000000
#   VITE_ADSENSE_SLOT_DEFAULT: id numérico da unidade de anúncio criada no painel
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_DEFAULT=

# Observabilidade. Mesma regra do AdSense: vazio = desligado, nada é carregado
# e nada é enviado. Preencha quando criar as contas (as duas têm plano free).
#   VITE_SENTRY_DSN: erros e crashes. Painel > Settings > Client Keys (DSN)
#   VITE_POSTHOG_KEY: analytics de produto. Começa com "phc_"
#   VITE_POSTHOG_HOST: só mude se a sua organização for na região da UE
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
